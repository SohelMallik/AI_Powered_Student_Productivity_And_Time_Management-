# ============================================================
#  Environment Variables – AI Student Productivity
#  Copy this file to .env:   cp .env.example .env
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Data storage directory (relative or absolute path)
DATA_DIR=./data

# Pomodoro defaults
POMODORO_WORK_MINUTES=25
POMODORO_BREAK_MINUTES=5

# Procrastination detection threshold (minutes since task created)
PROCRASTINATION_THRESHOLD_MINUTES=30

# Max daily study hours (for validation)
MAX_DAILY_STUDY_HOURS=12
