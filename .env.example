# ============================================================
#  Environment Variables – AI Student Productivity
#  Copy this file to .env:   cp .env.example .env
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Django database. Leave blank to use SQLite locally.
# On Vercel, set DATABASE_URL (or the Postgres URL supplied by Vercel Storage).
DATABASE_URL=
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
DJANGO_SECRET_KEY=

# Data storage directory (relative or absolute path)
DATA_DIR=./data

# Pomodoro defaults
POMODORO_WORK_MINUTES=25
POMODORO_BREAK_MINUTES=5

# Procrastination detection threshold (minutes since task created)
PROCRASTINATION_THRESHOLD_MINUTES=30

# Max daily study hours (verification)
MAX_DAILY_STUDY_HOURS=12
