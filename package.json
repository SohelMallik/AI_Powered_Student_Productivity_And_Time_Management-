{
  "name": "ai-student-productivity",
  "version": "1.0.0",
  "description": "AI-Powered Student Productivity & Time Management Assistant",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm":  ">=9.0.0"
  },
  "scripts": {
    "start"     : "node server/index.js",
    "dev"       : "nodemon --watch server --watch public server/index.js",
    "seed"      : "node scripts/seed.js || true",
    "setup"     : "node scripts/seed.js || true",
    "test"      : "jest --coverage",
    "test:unit" : "jest tests/unit --coverage=false",
    "test:int"  : "jest tests/integration --coverage=false",
    "lint"      : "eslint server/ --ext .js --fix"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors"       : "^2.8.5",
    "dotenv"     : "^16.3.1",
    "express"    : "^4.18.2",
    "fs-extra"   : "^11.1.1",
    "moment"     : "^2.29.4",
    "node-cron"  : "^3.0.3",
    "uuid"       : "^9.0.0"
  },
  "devDependencies": {
    "eslint"    : "^8.47.0",
    "jest"      : "^29.6.2",
    "nodemon"   : "^3.0.1",
    "supertest" : "^6.3.3"
  },
  "keywords": ["AI", "student", "productivity", "time-management", "pomodoro", "planner"],
  "author": "AI Student Productivity",
  "license": "MIT"
}
